#!/usr/bin/env python3
# Refresh the current mode's Launcher, pinned app icons, and Plasma icon views.
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

HOME = Path.home()
DBUS = [
    "qdbus6",
    "org.kde.plasmashell",
    "/PlasmaShell",
    "org.kde.PlasmaShell.evaluateScript",
]
SUFFIX = {
    "PHOSPHOR14Spring": "spring",
    "PHOSPHOR14Summer": "summer",
    "PHOSPHOR14Autumn": "autumn",
    "PHOSPHOR14Winter": "winter",
    "LOFI14": "lofi",
    "LOFI14Rainline": "lofi-rainline",
    "LOFI14Afterglow": "lofi-afterglow",
    "LOFI14Cassette": "lofi-cassette",
    "OVERDRIVE14": "overdrive",
    "OVERDRIVE14NeonTempest": "overdrive-tempest",
    "OVERDRIVE14Solarflare": "overdrive-solarflare",
    "OVERDRIVE14VioletArc": "overdrive-violet-arc",
    "OldTimes": "old-times",
