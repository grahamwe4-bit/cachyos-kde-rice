    "Spectrum14IridescentRain": "spectrum-iridescent-rain",
    "Spectrum14LunarFrequency": "spectrum-lunar-frequency",
    "Spectrum14DeepSpaceRadio": "spectrum-deep-space-radio",
    "Spectrum14DigitalSakura": "spectrum-digital-sakura",
    "Spectrum14PhotonGarden": "spectrum-photon-garden",
    "Spectrum14CobaltReverie": "spectrum-cobalt-reverie",
    "Spectrum14AmberSignal": "spectrum-amber-signal",
