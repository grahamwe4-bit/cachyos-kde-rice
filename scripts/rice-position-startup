#!/usr/bin/env python3
"""Place the two startup Konsole windows as borderless panes through KWin."""
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import time

if len(sys.argv) != 3 or not all(value.isdigit() and int(value) > 0 for value in sys.argv[1:]):
    raise SystemExit("Usage: rice-position-startup CMATRIX_PID CAVA_PID")
matrix_pid, cava_pid = map(int, sys.argv[1:])
plugin = "rice-startup-placement-{}".format(os.getpid())
runtime = os.environ.get("XDG_RUNTIME_DIR") or str(Path.home() / ".cache")
Path(runtime).mkdir(parents=True, exist_ok=True)
source = """
const matrixPid = %d;
const cavaPid = %d;
function placeRiceWindow(window) {
    const isMatrix = window.pid === matrixPid;
    const isCava = window.pid === cavaPid;
    if (!isMatrix && !isCava) return;
    window.noBorder = true;
    const area = workspace.clientArea(KWin.FullArea, window);
    const split = Math.min(Math.max(1, Math.round(area.width * 0.2547)), area.width - 1);
    window.frameGeometry = {
        x: isMatrix ? area.x : area.x + split,
        y: area.y,
        width: isMatrix ? split : area.width - split,
        height: area.height
    };
}
workspace.windowAdded.connect(placeRiceWindow);
workspace.windowList().forEach(placeRiceWindow);
""" % (matrix_pid, cava_pid)
path = None
loaded = False
try:
    with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", suffix=".js",
                                     prefix="rice-place-", dir=runtime, delete=False) as f:
        path = f.name
        f.write(source)
    result = subprocess.run(["qdbus6", "org.kde.KWin", "/Scripting",
                             "org.kde.kwin.Scripting.loadScript", path, plugin],
                            text=True, capture_output=True, check=True, timeout=5)
    script_id = int(result.stdout.strip())
    if script_id < 0:
        raise RuntimeError("KWin could not load the placement script")
    loaded = True
    subprocess.run(["qdbus6", "org.kde.KWin", "/Scripting/Script{}".format(script_id),
                    "org.kde.kwin.Script.run"], check=True, timeout=5)
    time.sleep(12)
finally:
    if loaded:
        subprocess.run(["qdbus6", "org.kde.KWin", "/Scripting",
                        "org.kde.kwin.Scripting.unloadScript", plugin],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
    if path:
        Path(path).unlink(missing_ok=True)
